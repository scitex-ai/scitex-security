[Unit]
Description=Daily: scitex-security domains watch

[Timer]
# New look-alike registrations, MX records and certificates change on the
# scale of days; daily is enough and keeps crt.sh / RDAP load polite. The
# random delay spreads hosts so they do not hit crt.sh at the same minute.
OnCalendar=*-*-* 06:15:00
RandomizedDelaySec=20min
Persistent=true

[Install]
WantedBy=timers.target
