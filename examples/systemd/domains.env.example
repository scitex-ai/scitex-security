# ~/.scitex/security/domains.env -- read by scitex-security-domains.service.
# Domains you own to watch, plus extra domains you own that must never be
# reported (--owned).
SCITEX_SECURITY_DOMAINS_ARGS=example.org example.net --owned example-org.com

# Sender profile "ops" (scitex-notification >= 0.3.2): From no-reply@ To the
# dev list. The password may be a gpg ciphertext decrypted in memory.
SCITEX_NOTIFICATION_PROFILE_OPS_FROM=no-reply@example.org
SCITEX_NOTIFICATION_PROFILE_OPS_FROM_NAME=Domain watch
SCITEX_NOTIFICATION_PROFILE_OPS_TO=dev@example.org
SCITEX_NOTIFICATION_PROFILE_OPS_SMTP_HOST=smtp.example.org
SCITEX_NOTIFICATION_PROFILE_OPS_SMTP_PORT=587
SCITEX_NOTIFICATION_PROFILE_OPS_PASSWORD_GPG=~/.config/scitex/no-reply.pw.gpg
